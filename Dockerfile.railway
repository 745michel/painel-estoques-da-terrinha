# Dockerfile so para o deploy no Railway (Fase 1 da migracao) - roda o Next.js puro
# (app/page.tsx, caminho dinamico ja existente), sem passar pelo vinext/Cloudflare Workers
# (vite.config.ts/worker continuam intactos, usados so no dev local via "npm run dev").
# Nao afeta em nada o "npm run build/start/dev" existentes.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install
COPY . .
RUN npx next build

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/next.config.ts ./next.config.ts
COPY --from=build /app/proxy.ts ./proxy.ts
COPY --from=build /app/auth.ts ./auth.ts
COPY --from=build /app/db ./db
EXPOSE 3000
CMD ["sh", "-c", "npx next start -p ${PORT:-3000}"]
